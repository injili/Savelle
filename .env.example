# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.
# Nuxt maps NUXT_* variables onto runtimeConfig at runtime.

# Public site URL (no trailing slash). Canonical URLs, OG tags, sitemap, JSON-LD.
NUXT_PUBLIC_SITE_URL=https://www.example.com

# Show unpublished content (case studies, forthcoming insight pages, founder placeholder, /dev pages).
# Default: on in `nuxt dev` and on Vercel Preview deployments, off in Production.
# NUXT_PUBLIC_SHOW_DRAFTS=false

# Enquiry email (Resend)
NUXT_RESEND_API_KEY=
NUXT_ENQUIRY_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Savelle website <website@yourdomain>"
NUXT_ENQUIRY_FROM_EMAIL=

# Optional: shared rate limiting across Vercel function instances (Upstash Redis REST).
# Without these, a per-instance in-memory limiter is used.
NUXT_UPSTASH_REDIS_REST_URL=
NUXT_UPSTASH_REDIS_REST_TOKEN=
